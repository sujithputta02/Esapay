# ESA Environment Configuration

# Database
DATABASE_URL=postgres://esa:esa_dev_password@localhost:5432/esa_db

# Redis
REDIS_URL=redis://localhost:6379

# NATS
NATS_URL=nats://localhost:4222

# Ollama & Hugging Face AI Brain (24/7 Live Inference)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_MODELS=qwen2.5:0.5b llama3.2:1b
OLLAMA_KEEP_ALIVE=-1
HF_AI_BRAIN_URL=https://sujithputta-esa-ai-brain.hf.space


# Logging
RUST_LOG=info

# API
API_HOST=0.0.0.0
API_PORT=8080

# Infrastructure Mutation (Disabled by default for safe operation)
KUBERNETES_ENABLED=false

# Razorpay Test Mode — put your real keys in .env (this file is safe to commit)
# Key ID + Key Secret: Razorpay Dashboard → Settings → API Keys (Test Mode)
# Webhook Secret: Dashboard → Webhooks → create webhook → copy secret (NOT the API secret)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
RAZORPAY_MODE=test
RAZORPAY_API_BASE=https://api.razorpay.com/v1
# Rate limits (requests per second)
RAZORPAY_WEBHOOK_RATE_LIMIT_PER_SEC=30
RAZORPAY_API_RATE_LIMIT_PER_SEC=10

# Supabase Auth, Storage & API Key Ledger (put your real keys in .env)
SUPABASE_URL=https://your-project.supabase.co
# Cryptographic JWT verification (HS256 secret or RS256 public key PEM)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
SUPABASE_JWT_PUBLIC_KEY=
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_ANON_KEY=sb_publishable_your_key_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_DB_PASSWORD=your_db_password_here

# ESAPay API Keys & Endpoints (Live Production & Test Sandbox)
# Used by CLI, TypeScript SDK, Python SDK, and API Service
ESA_API_URL=https://esapay-api.onrender.com
ESA_LIVE_API_KEY=esa_live_sec_your_production_secret_key_here
ESA_TEST_API_KEY=esa_test_demo_your_test_sandbox_key_here
ESA_API_KEY=esa_live_sec_your_production_secret_key_here

# Administrative Security & Access Control
# Required for admin routes (/api/audit/*, /api/introspect/*, /api/metrics/*, /api/keys/revoke, /api/gateways/:name/toggle).
# Live/production mode STRICTLY requires an admin key with a minimum of 32 characters (startup fails closed if missing or shorter).
# Startup validates key length (minimum 32 characters), not entropy or randomness.
# Generate a cryptographically secure random key using: openssl rand -hex 32
# DO NOT commit a usable default admin key to version control.
# ESA_ADMIN_API_KEY=

# Rate-Limiter Log Privacy & Pseudonymization
# Optional secret key used for keyed HMAC-SHA256 pseudonymous client identifiers in rate-limit warning logs.
# If configured, provides stable pseudonymous correlation across cluster nodes and service restarts.
# If omitted or empty, the server automatically generates a secure 256-bit random secret per process lifetime.
# Note: This produces pseudonymous identifiers for log correlation, not full anonymization.
# Generate a secret using: openssl rand -hex 32
# ESA_LOG_HMAC_SECRET=

# Environment & Payment Modes
# ENVIRONMENT: development, test, sandbox, or production
ENVIRONMENT=development
# ESA_PAYMENT_MODE: live or test/sandbox
ESA_PAYMENT_MODE=sandbox
# Explicit simulation opt-in for local demo/testing without live gateways
ESA_ENABLE_SIMULATED_CHECKOUT=true

# Reverse Proxy Security & Client IP Resolution
# Reverse proxies MUST be specified as explicit CIDRs (boolean 'true' is rejected for security).
# DO NOT trust entire broad private networks (/8, /12, /16) as that permits any internal node, pod, or container to spoof client IPs.
# TRUSTED_PROXIES: Explicit CIDRs/IPs of your actual upstream reverse proxy or ingress controllers (e.g. AWS ALB, NGINX).
# Specify ONLY the exact proxy IP addresses or narrow subnets (e.g. 10.0.1.50/32 or 172.20.4.0/28).
# Uses right-to-left X-Forwarded-For trusted traversal stopping at the first untrusted hop.
# TRUSTED_PROXIES=10.0.1.50/32
TRUSTED_PROXIES=

# CLOUDFLARE_PROXIES: Cloudflare edge reverse proxy CIDRs (both official IPv4 and IPv6 ranges).
# Only incoming connections from these verified Cloudflare edge ranges are permitted to supply CF-Connecting-IP.
# Generic proxies in TRUSTED_PROXIES will NEVER be permitted to supply CF-Connecting-IP.
CLOUDFLARE_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32


