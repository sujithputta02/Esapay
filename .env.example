# ESA Environment Configuration

# Database
DATABASE_URL=postgres://esa:esa_dev_password@localhost:5432/esa_db

# Redis
REDIS_URL=redis://localhost:6379

# NATS
NATS_URL=nats://localhost:4222

# Ollama & Hugging Face AI Brain (24/7 Live Inference)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_MODELS=qwen2.5:0.5b llama3.2:1b
OLLAMA_KEEP_ALIVE=-1
HF_AI_BRAIN_URL=https://sujithputta-esa-ai-brain.hf.space


# Logging
RUST_LOG=info

# API
API_HOST=0.0.0.0
API_PORT=8080

# Razorpay Test Mode — put your real keys in .env (this file is safe to commit)
# Key ID + Key Secret: Razorpay Dashboard → Settings → API Keys (Test Mode)
# Webhook Secret: Dashboard → Webhooks → create webhook → copy secret (NOT the API secret)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
RAZORPAY_MODE=test
RAZORPAY_API_BASE=https://api.razorpay.com/v1
# Rate limits (requests per second)
RAZORPAY_WEBHOOK_RATE_LIMIT_PER_SEC=30
RAZORPAY_API_RATE_LIMIT_PER_SEC=10

# Supabase Auth, Storage & API Key Ledger (put your real keys in .env)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_ANON_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_DB_PASSWORD=your_db_password_here
