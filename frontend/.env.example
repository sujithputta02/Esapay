# ESAPay Frontend Environment Variables Template
# Copy this file to .env.local and configure your credentials.

# Supabase Auth, Storage & API Key Ledger
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ESAPay API Endpoint & Sandbox Evaluation Key
VITE_API_URL=https://esapay-api.onrender.com
# Test/sandbox evaluation key only (public in client bundles - never use live secret keys here)
VITE_ESA_TEST_API_KEY=esa_test_demo_your_test_sandbox_key_here

